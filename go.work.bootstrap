replace github.com/kisstar/x-tools/go/kernel => ./go/kernel
replace github.com/kisstar/x-tools/go/modules/preferences => ./go/modules/preferences
replace github.com/kisstar/x-tools/go/transports/http => ./go/transports/http
replace github.com/kisstar/x-tools/go/transports/ws => ./go/transports/ws
