{
  "name": "xtools",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": { "node": ">=24.1.0" },
  "scripts": {
    "build": "turbo run build",
    "codegen": "env GOCACHE=/tmp/xtools-go-cache GOMODCACHE=/tmp/xtools-go-modcache go run ./go/modules/preferences/cmd/codegen",
    "codegen:check": "sh scripts/check-codegen.sh",
    "dev": "turbo run dev",
    "e2e": "playwright test",
    "lint": "turbo run lint && node --test tests/architecture/*.test.mjs",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@playwright/test": "catalog:",
    "@tanstack/react-router": "catalog:",
    "eslint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
